<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.INTERNET"/>
 <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
 <queries><intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent></queries>
 <application android:label="PARASITE" android:usesCleartextTraffic="false"
   android:theme="@android:style/Theme.Material.NoActionBar">
  <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="landscape">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
  </activity>
  <provider android:name=".ApkProvider" android:authorities="studio.transform.launcher.apks"
   android:exported="false" android:grantUriPermissions="true"/>
 </application>
</manifest>
